{
  "expo": {
    "name": "Makhos",
    "slug": "makhos-thai-checkers",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.voidlightdhm.makhos"
    },
    "android": {
      "package": "com.voidlightdhm.makhos",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "4e5761f4-2bd4-4152-a45b-a606caa7d9b6"
      }
    },
    "plugins": [
      "expo-font",
      "onnxruntime-react-native"
    ],
    "assetBundlePatterns": [
      "assets/**/*",
      "models/**/*"
    ]
  }
}
