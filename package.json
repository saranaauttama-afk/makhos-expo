{
  "name": "makhos-expo",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test:tactical": "tsc --target ES2022 --module CommonJS --moduleResolution node --strict --esModuleInterop --skipLibCheck --outDir .tmp/tactical scripts/tacticalSuite.ts && node .tmp/tactical/scripts/tacticalSuite.js",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:prod": "eas build --platform android --profile production",
    "submit:android:prod": "eas submit --platform android --profile production"
  },
  "dependencies": {
    "@expo-google-fonts/kanit": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.33",
    "expo-av": "~16.0.8",
    "expo-font": "~14.0.11",
    "expo-status-bar": "~3.0.9",
    "onnxruntime-react-native": "^1.24.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "onnxruntime-node": "^1.24.3",
    "typescript": "~5.9.2"
  },
  "private": true
}
